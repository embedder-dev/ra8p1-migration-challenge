            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_06" display="06" value="06" />
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_07" display="07" value="07" />
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_08" display="08" value="08" />
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_09" display="09" value="09" />
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_10" display="10" value="10" />
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PORT_11" display="11" value="11" />
        </property>
        <property default="module.driver.nfc_reader_ptx.pin_control_pin.PIN_DISABLE" display="NFC Interrupt Pin" id="module.driver.nfc_reader_ptx.pin_control_pin" description="Specify the interrupt port/pin used by the NFC chip to signal for SPI communications.">
            <option id="module.driver.nfc_reader_ptx.pin_control_port.PIN_DISABLE" display="Disabled" value="FF" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_00" display="00" value="00" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_01" display="01" value="01" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_02" display="02" value="02" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_03" display="03" value="03" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_04" display="04" value="04" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_05" display="05" value="05" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_06" display="06" value="06" />
            <option id="module.driver.nfc_reader_ptx.pin_control_pin.PIN_07" display="07" value="07" />
