        </property>

        <property default="5" display="Device Limit" id="module.driver.nfc_reader_ptx.device_limit" description="Select the max number of tags to discover.">
            <constraint display="Must be an integer greater than 0 and less than 50">testInteger("${module.driver.nfc_reader_ptx.device_limit}")  &amp;&amp; ("${module.driver.nfc_reader_ptx.device_limit}" &gt; 0) &amp;&amp; ("${module.driver.nfc_reader_ptx.device_limit}" &lt; 50)</constraint>
        </property>
        <property default="100" display="Idle Time" id="module.driver.nfc_reader_ptx.idle_time" description="Select idle time between polling cycles (ms).">
            <constraint display="Must be an integer greater than 0 and less than 65535">testInteger("${module.driver.nfc_reader_ptx.idle_time}")  &amp;&amp; ("${module.driver.nfc_reader_ptx.idle_time}" &gt; 0) &amp;&amp; ("${module.driver.nfc_reader_ptx.idle_time}" &lt; 65535)</constraint>
        </property>
        <header>
/** NFC Reader PTX Device*/
extern  nfc_reader_ptx_instance_ctrl_t  ${module.driver.nfc_reader_ptx_device.name}_ctrl;
extern const nfc_reader_ptx_cfg_t       ${module.driver.nfc_reader_ptx_device.name}_cfg;

        </header>
        <includes>
#include &quot;rm_nfc_reader_ptx.h&quot;
        </includes>
        <declarations>
/** NFC Reader PTX configuration */
ptxIoTRd_t ptx_nfc_context;

/** NFC Reader PTX Interrupt Pin */
#define NFC_READER_PTX_INTERRUPT_PIN    BSP_IO_PORT_${module.driver.nfc_reader_ptx.pin_control_port}_PIN_${module.driver.nfc_reader_ptx.pin_control_pin}

/** NFC Reader PTX Device*/
nfc_reader_ptx_instance_ctrl_t ${module.driver.nfc_reader_ptx_device.name}_ctrl;

/** NFC Reader PTX configuration */
const nfc_reader_ptx_cfg_t     ${module.driver.nfc_reader_ptx_device.name}_cfg =
{
    #define RA_NOT_DEFINED (1)

    .poll_type_a              = (${module.driver.nfc_reader_ptx.poll_type_a}),
    .poll_type_b              = (${module.driver.nfc_reader_ptx.poll_type_b}),
    .poll_type_v              = (${module.driver.nfc_reader_ptx.poll_type_v}),
    .poll_type_f              = (${module.driver.nfc_reader_ptx.poll_type_f}),
    .temp_sensor_calibrate    = (${module.driver.nfc_reader_ptx.temp_sensor_calibrate}),
    .temp_sensor_shutdown     = (${module.driver.nfc_reader_ptx.temp_sensor_shutdown}),
    .temp_sensor_ambient      = (${module.driver.nfc_reader_ptx.temp_sensor_ambient}),
    .device_limit           = (${module.driver.nfc_reader_ptx.device_limit}),
    .interrupt_pin          = NFC_READER_PTX_INTERRUPT_PIN,
    .idle_time_ms           = (${module.driver.nfc_reader_ptx.idle_time}),
    .iot_reader_context     = &amp;ptx_nfc_context,
    .p_comms_instance_ctrl    = (rm_comms_instance_t *)&amp;${module.driver.nfc_reader_ptx.requires.comms::module.driver.comms_spi_device.name},
    .p_gpio_context         = (ioport_instance_t *)&amp;g_ioport,
    .p_irq_context          = (external_irq_instance_t *)&amp;${module.driver.nfc_reader_ptx.requires.irq::module.driver.external_irq.name},
    .p_timer_context        = (timer_instance_t *)&amp;${module.driver.nfc_reader_ptx.requires.sleep_timer::module.driver.timer.name},
    .p_app_timer            = (timer_instance_t *)&amp;${module.driver.nfc_reader_ptx.requires.tdc_timer::module.driver.timer.name},
};

        </declarations>
    </module>
</raModuleDescription>



